# SEO Control Center configuration.
# Copy to .env and adjust. Never commit .env.

APP_ENV=local            # local | testing | production
APP_DEBUG=true           # must be false in production
APP_URL=http://seo-control-center.test
APP_TIMEZONE=UTC         # display default; storage is always UTC
# SUPPORT_EMAIL=                                 # "Report a bug" by e-mail; empty opens GitHub issues
# COMMUNITY_URL=https://discord.gg/5pPRTCww2X     # Discord community link; empty hides it

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=seo_control_center
DB_USERNAME=root
DB_PASSWORD=

# Features to turn off, comma separated, for example backlinks,mcp. Empty: everything is on.
# DISABLED_FEATURES=

# AGPL-3.0 section 13: if you run a changed version for others, point this at your changed source.
# SOURCE_CODE_URL=

# Queue/cron. CRON_INTERVAL_MINUTES = how often the host runs bin/cron.php (often 5 on shared hosting).
CRON_INTERVAL_MINUTES=1
QUEUE_CRON_MAX_SECONDS=50
QUEUE_WORKER_SLOTS=2

# DataForSEO: sandbox returns sample data and is never charged (use on staging)
DATAFORSEO_SANDBOX=false
DATAFORSEO_RAW_RESPONSE_DAYS=7

# Database backups kept in storage/backups
BACKUP_KEEP=7

SESSION_IDLE_MINUTES=120
SESSION_LIFETIME_HOURS=168

LOG_LEVEL=debug          # debug | info | notice | warning | error | critical | alert | emergency

# Encryption key ring (used from slice 2 onward; see ENVIRONMENT.md -> Encryption keys)
# APP_KEYRING_PATH=

# Integration tests (optional). Use a separate, disposable database.
# TEST_DB_HOST=127.0.0.1
# TEST_DB_PORT=3306
# TEST_DB_DATABASE=seo_control_center_test
# TEST_DB_USERNAME=root
# TEST_DB_PASSWORD=
